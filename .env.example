# Database Configuration
# PostgreSQL is the primary target. If connection fails, the system falls back to SQLite automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dshield

# Serial Gateway Settings
SERIAL_PORT=COM3
SERIAL_BAUD=115200
USE_SERIAL=false

# Risk Engine Thresholds (Prototype Demonstration Values)
# Landslide thresholds
LANDSLIDE_SOIL_MOISTURE_WARN=60.0
LANDSLIDE_SOIL_MOISTURE_CRIT=80.0
LANDSLIDE_VIBRATION_WARN=2.5
LANDSLIDE_VIBRATION_CRIT=5.0

# Flood thresholds
FLOOD_WATER_LEVEL_WARN=3.0
FLOOD_WATER_LEVEL_CRIT=4.5
FLOOD_RISE_RATE_WARN=0.5
FLOOD_RISE_RATE_CRIT=1.0

# Sensor mounting height for Node 2 ultrasonic (meters)
ULTRASONIC_MOUNTING_HEIGHT=5.0
